if(BUILD_TESTING AND WEBOLUTION_HAVE_SDL2 AND DEFINED WEBOLUTION_GAME_DIR)
  set(pick_nearest_root "${CMAKE_SOURCE_DIR}/build/lemming-pick-nearest-001")
  foreach(side IN ITEMS before after)
    if(side STREQUAL "before" AND NOT EXISTS "${pick_nearest_root}/before-source/src/app/main.cpp")
      continue()
    endif()
    add_executable(test_pick_nearest_${side} src/__test__/test_pick_nearest.cpp)
    target_link_libraries(test_pick_nearest_${side} PRIVATE webolution_app webolution_objects)
    if(side STREQUAL "before")
      target_sources(test_pick_nearest_before PRIVATE "${pick_nearest_root}/before-source/src/app/main.cpp")
      target_compile_definitions(test_pick_nearest_before PRIVATE PICK_NEAREST_BEFORE=1
        WEBOLUTION_APP_NO_MAIN=1 WEBOLUTION_HAVE_SDL2=1)
    else()
      target_link_libraries(test_pick_nearest_after PRIVATE webolution_app_nomain)
    endif()
    foreach(route IN ITEMS upright-left upright-right upright-between upright-overlap inverted-left inverted-right inverted-between)
      add_test(NAME pick_nearest_${route}_${side} COMMAND test_pick_nearest_${side} ${route}
        "${CMAKE_CURRENT_BINARY_DIR}/pick-nearest-${side}/${route}")
      set_tests_properties(pick_nearest_${route}_${side} PROPERTIES TIMEOUT 120
        ENVIRONMENT "SDL_VIDEODRIVER=dummy;SDL_AUDIODRIVER=dummy;WEBOLUTION_GAME_DIR=${WEBOLUTION_GAME_DIR}")
    endforeach()
  endforeach()
  add_test(NAME pick_nearest_units COMMAND test_pick_nearest_after units)
  set_tests_properties(pick_nearest_units PROPERTIES TIMEOUT 30)
  add_test(NAME pick_nearest_reference COMMAND ${CMAKE_COMMAND}
    "-DGAME_DIR=${WEBOLUTION_GAME_DIR}" -P "${CMAKE_SOURCE_DIR}/cmake/pick_nearest_reference.cmake")
  set_tests_properties(pick_nearest_reference PROPERTIES TIMEOUT 30)
  if(TARGET test_pick_nearest_before)
    add_test(NAME pick_nearest_identity COMMAND ${CMAKE_COMMAND}
      "-DTASK_DIR=${pick_nearest_root}" -P "${CMAKE_SOURCE_DIR}/cmake/pick_nearest_identity.cmake")
    set_tests_properties(pick_nearest_identity PROPERTIES TIMEOUT 30)
    set(pick_nearest_dependencies)
    foreach(route IN ITEMS upright-left upright-right upright-between upright-overlap inverted-left inverted-right inverted-between)
      set_tests_properties(pick_nearest_${route}_before PROPERTIES DEPENDS pick_nearest_identity)
      list(APPEND pick_nearest_dependencies pick_nearest_${route}_before pick_nearest_${route}_after)
    endforeach()
    find_package(Python3 COMPONENTS Interpreter REQUIRED)
    add_test(NAME pick_nearest_comparison COMMAND "${Python3_EXECUTABLE}"
      "${CMAKE_SOURCE_DIR}/tools/compare_pick_nearest.py" "${CMAKE_CURRENT_BINARY_DIR}")
    set_tests_properties(pick_nearest_comparison PROPERTIES TIMEOUT 30 DEPENDS "${pick_nearest_dependencies}")
  endif()
endif()
