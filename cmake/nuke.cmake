if(BUILD_TESTING AND WEBOLUTION_HAVE_SDL2 AND DEFINED WEBOLUTION_GAME_DIR)
  # These historical comparisons link current production objects to retained
  # method sources. Nuke adds fields to World, LevelSetup and Lemming: compiling
  # the retained headers as well would mix two layouts in one executable.
  # Preserve the immutable snapshots/identity checks. Build byte-identical .cpp
  # copies with the current World declaration in a separate, explicit ABI
  # overlay. This is a historical-method comparison, not a fully frozen build.
  set(nuke_abi_root "${CMAKE_CURRENT_BINARY_DIR}/nuke-baseline-abi")
  file(WRITE "${nuke_abi_root}/provenance.tsv" "target\toriginal\tcompiled_copy\tsha256\n")
  foreach(legacy IN ITEMS test_frontendwindowquit_before test_fastforward_toggle_baseline
      test_fluid_hazard_before test_fluid_hazard_gadget_before
      test_empty_receiver_before test_empty_receiver_hatch_before
      test_empty_receiver_gadget_before test_gravity_gadgets_before)
    if(NOT TARGET ${legacy})
      continue()
    endif()
    get_target_property(legacy_sources ${legacy} SOURCES)
    get_target_property(legacy_includes ${legacy} INCLUDE_DIRECTORIES)
    set(abi_sources)
    set(abi_includes)
    set(snapshot_roots)
    foreach(source IN LISTS legacy_sources)
      if(source MATCHES "^(${CMAKE_SOURCE_DIR}/build/([^/]+)/before-source)/(.+)$")
        set(snapshot "${CMAKE_MATCH_1}")
        set(task "${CMAKE_MATCH_2}")
        set(relative "${CMAKE_MATCH_3}")
        set(copy "${nuke_abi_root}/${task}/${relative}")
        configure_file("${source}" "${copy}" COPYONLY)
        file(SHA256 "${source}" identity)
        file(APPEND "${nuke_abi_root}/provenance.tsv" "${legacy}\t${source}\t${copy}\t${identity}\n")
        list(APPEND abi_sources "${copy}")
        list(APPEND snapshot_roots "${snapshot}")
      else()
        list(APPEND abi_sources "${source}")
      endif()
    endforeach()
    foreach(directory IN LISTS legacy_includes)
      if(directory MATCHES "^(${CMAKE_SOURCE_DIR}/build/([^/]+)/before-source)(/.*)?$")
        list(APPEND snapshot_roots "${CMAKE_MATCH_1}")
        list(APPEND abi_includes "${nuke_abi_root}/${CMAKE_MATCH_2}${CMAKE_MATCH_3}")
      else()
        list(APPEND abi_includes "${directory}")
      endif()
    endforeach()
    list(REMOVE_DUPLICATES snapshot_roots)
    foreach(snapshot IN LISTS snapshot_roots)
      get_filename_component(task "${snapshot}/.." ABSOLUTE)
      get_filename_component(task "${task}" NAME)
      file(GLOB_RECURSE headers CONFIGURE_DEPENDS "${snapshot}/*.h" "${snapshot}/*.hpp")
      foreach(header IN LISTS headers)
        file(RELATIVE_PATH relative "${snapshot}" "${header}")
        if(relative STREQUAL "src/sim/World.h")
          continue()
        endif()
        configure_file("${header}" "${nuke_abi_root}/${task}/${relative}" COPYONLY)
      endforeach()
      configure_file("${CMAKE_SOURCE_DIR}/src/sim/World.h"
        "${nuke_abi_root}/${task}/src/sim/World.h" COPYONLY)
      file(SHA256 "${CMAKE_SOURCE_DIR}/src/sim/World.h" identity)
      file(APPEND "${nuke_abi_root}/provenance.tsv"
        "${legacy}\t${CMAKE_SOURCE_DIR}/src/sim/World.h\t${nuke_abi_root}/${task}/src/sim/World.h\t${identity}\n")
    endforeach()
    set_property(TARGET ${legacy} PROPERTY SOURCES "${abi_sources}")
    set_property(TARGET ${legacy} PROPERTY INCLUDE_DIRECTORIES "${abi_includes}")
  endforeach()

  set(nuke_root "${CMAKE_SOURCE_DIR}/build/nuke-all-001")
  foreach(side IN ITEMS before after)
    if(side STREQUAL "before" AND NOT EXISTS "${nuke_root}/before-source/src/app/main.cpp")
      continue()
    endif()
    add_executable(test_nuke_${side} src/__test__/test_nuke.cpp)
    target_link_libraries(test_nuke_${side} PRIVATE webolution_app webolution_objects SDL2::SDL2)
    if(side STREQUAL "before")
      target_sources(test_nuke_before PRIVATE "${nuke_root}/before-source/src/app/main.cpp")
      target_compile_definitions(test_nuke_before PRIVATE NUKE_BEFORE=1 WEBOLUTION_APP_NO_MAIN=1 WEBOLUTION_HAVE_SDL2=1)
    else()
      target_link_libraries(test_nuke_after PRIVATE webolution_app_nomain)
    endif()
    add_test(NAME nuke_pointer_${side} COMMAND test_nuke_${side} live "${CMAKE_CURRENT_BINARY_DIR}/nuke-${side}/live")
    set_tests_properties(nuke_pointer_${side} PROPERTIES TIMEOUT 180
      ENVIRONMENT "SDL_VIDEODRIVER=dummy;SDL_AUDIODRIVER=dummy;WEBOLUTION_GAME_DIR=${WEBOLUTION_GAME_DIR}")
  endforeach()
  foreach(mode IN ITEMS units empty partial)
    add_test(NAME nuke_${mode} COMMAND test_nuke_after ${mode} "${CMAKE_CURRENT_BINARY_DIR}/nuke-after/${mode}")
    set_tests_properties(nuke_${mode} PROPERTIES TIMEOUT 180
      ENVIRONMENT "SDL_VIDEODRIVER=dummy;SDL_AUDIODRIVER=dummy;WEBOLUTION_GAME_DIR=${WEBOLUTION_GAME_DIR}")
  endforeach()
  if(TARGET test_nuke_before)
    add_test(NAME nuke_baseline_identity COMMAND ${CMAKE_COMMAND} "-DTASK_DIR=${nuke_root}" -P "${CMAKE_SOURCE_DIR}/cmake/nuke_identity.cmake")
    set_tests_properties(nuke_baseline_identity PROPERTIES TIMEOUT 30)
    set_tests_properties(nuke_pointer_before PROPERTIES DEPENDS nuke_baseline_identity)
  endif()
endif()
