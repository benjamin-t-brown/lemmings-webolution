# U1: authentic task-entry renderer paired with current production path.
if(BUILD_TESTING AND WEBOLUTION_HAVE_SDL2)
  set(co_root "${CMAKE_SOURCE_DIR}/build/climber-occlusion-001")
  foreach(side IN ITEMS before after)
    if(side STREQUAL "before")
      if(NOT EXISTS "${co_root}/before-source/src/app/TubeScene.cpp")
        continue()
      endif()
      set(co_scene "${co_root}/before-source/src/app/TubeScene.cpp")
      set(co_compare "-")
    else()
      set(co_scene src/app/TubeScene.cpp)
      set(co_compare "-")
      if(TARGET test_climber_occlusion_before)
        set(co_compare "${co_root}/before")
      endif()
    endif()
    add_executable(test_climber_occlusion_${side} src/__test__/test_climber_occlusion.cpp ${co_scene})
    target_link_libraries(test_climber_occlusion_${side} PRIVATE actor_occlusion_support webolution_objects)
    add_test(NAME climber_occlusion_${side} COMMAND test_climber_occlusion_${side} ${side}
      "${co_root}/${side}" "${co_compare}")
    set_tests_properties(climber_occlusion_${side} PROPERTIES TIMEOUT 180
      ENVIRONMENT "SDL_VIDEODRIVER=dummy;SDL_AUDIODRIVER=dummy;WEBOLUTION_GAME_DIR=${WEBOLUTION_GAME_DIR}")
    add_executable(test_climber_occlusion_app_${side} src/__test__/test_climber_occlusion_app.cpp ${co_scene}
      src/app/main.cpp)
    target_link_libraries(test_climber_occlusion_app_${side} PRIVATE actor_occlusion_support webolution_objects)
    target_compile_definitions(test_climber_occlusion_app_${side} PRIVATE WEBOLUTION_APP_NO_MAIN=1 WEBOLUTION_HAVE_SDL2=1)
    set(app_compare "-")
    if(side STREQUAL "after" AND TARGET test_climber_occlusion_before)
      set(app_compare "${co_root}/app-before")
    endif()
    add_test(NAME climber_occlusion_app_${side} COMMAND test_climber_occlusion_app_${side} ${side}
      "${co_root}/app-${side}" "${app_compare}")
    set_tests_properties(climber_occlusion_app_${side} PROPERTIES TIMEOUT 180
      ENVIRONMENT "SDL_VIDEODRIVER=dummy;SDL_AUDIODRIVER=dummy;WEBOLUTION_GAME_DIR=${WEBOLUTION_GAME_DIR}")
  endforeach()
  if(TARGET test_climber_occlusion_before)
    add_test(NAME climber_occlusion_identity COMMAND ${CMAKE_COMMAND}
      "-DBASELINE=${co_root}/before-source" -P "${CMAKE_SOURCE_DIR}/cmake/climber_occlusion_identity.cmake")
    set_tests_properties(climber_occlusion_identity PROPERTIES TIMEOUT 30)
    set_tests_properties(climber_occlusion_before climber_occlusion_app_before PROPERTIES DEPENDS "climber_occlusion_identity;actor_depth_reference")
    set_tests_properties(climber_occlusion_after PROPERTIES DEPENDS climber_occlusion_before)
    set_tests_properties(climber_occlusion_app_after PROPERTIES DEPENDS climber_occlusion_app_before)
  endif()
endif()
