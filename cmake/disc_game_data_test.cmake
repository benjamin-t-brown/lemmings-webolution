string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(scratch "${CMAKE_CURRENT_BINARY_DIR}/disc-game-data-${suffix}")
if(EXISTS "${scratch}")
  message(FATAL_ERROR "Disc test scratch directory already exists: ${scratch}")
endif()
file(MAKE_DIRECTORY "${scratch}")
execute_process(COMMAND "${TEST_EXE}" "${scratch}" "${DISC_IMAGE}"
                RESULT_VARIABLE result ERROR_VARIABLE diagnostics ECHO_ERROR_VARIABLE)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Disc game data test failed (${result}). Evidence: ${scratch}")
endif()
string(REGEX MATCHALL "Warning: the CD image is shorter than the declared ISO 9660 volume"
       volume_warnings "${diagnostics}")
list(LENGTH volume_warnings warning_count)
if(NOT warning_count EQUAL 3)
  message(FATAL_ERROR "Expected one warning per trimmed synthetic layout, got ${warning_count}. Evidence: ${scratch}")
endif()
if(EXISTS "${DISC_IMAGE}" AND NOT IS_DIRECTORY "${DISC_IMAGE}")
  function(check_hash name expected)
    file(SHA256 "${scratch}/retail/${name}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "${name} SHA-256 mismatch: ${actual}")
    endif()
    message(STATUS "${name} SHA-256 ${actual}")
  endfunction()
  check_hash(lemmings.box 74b544beee769b0354e64b25eaec06fe725d50d2df11a94270600ae03a7e6a51)
  check_hash(patch.box a393a45e71d797fc5b646a9a235d1f64298129f378c6f4b79f47ec773d00de53)
endif()
file(REMOVE_RECURSE "${scratch}")
