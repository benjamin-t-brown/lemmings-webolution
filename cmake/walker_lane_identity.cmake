# Authentic task-entry source manifest, pinned before production edits.
get_filename_component(task_dir "${BASELINE}" DIRECTORY)
file(SHA256 "${task_dir}/before-hashes.json" manifest_sha)
if(NOT manifest_sha STREQUAL "8308e7a7510e3aeb6fcf56c1d6fea96e27b860feebe822488de642d10f8294da")
  message(FATAL_ERROR "walker-lane source manifest changed")
endif()
file(READ "${task_dir}/before-hashes.json" manifest)
string(JSON count LENGTH "${manifest}")
math(EXPR last "${count} - 1")
foreach(i RANGE 0 ${last})
  string(JSON path MEMBER "${manifest}" ${i})
  string(JSON expected GET "${manifest}" "${path}")
  file(SHA256 "${BASELINE}/${path}" measured)
  if(NOT measured STREQUAL expected)
    message(FATAL_ERROR "walker-lane frozen source changed: ${path}")
  endif()
endforeach()
