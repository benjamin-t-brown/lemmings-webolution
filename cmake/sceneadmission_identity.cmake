# scene-admission-001 test: the frozen "before" sources must be the supervisor's
# task-entry files; any mismatch fails. Reads bytes only. Usage:
#   cmake -DFROZEN_DIR=<dir> -DMANIFEST=<before-source-hashes.json> -P sceneadmission_identity.cmake
include("${CMAKE_CURRENT_LIST_DIR}/sceneadmission_freeze.cmake")

set(_failed FALSE)
set(_manifest "")
if(EXISTS "${MANIFEST}")
  file(READ "${MANIFEST}" _manifest)
else()
  message(STATUS "manifest ${MANIFEST} not present; comparing against the recorded entry hashes only")
endif()

foreach(item IN ITEMS "BackdropScene.cpp|BackdropScene.cpp|BackdropScene_cpp" "app/BackdropScene.h|BackdropScene.h|BackdropScene_h")
  string(REPLACE "|" ";" parts "${item}")
  list(GET parts 0 rel)
  list(GET parts 1 leaf)
  list(GET parts 2 id)
  if(NOT EXISTS "${FROZEN_DIR}/${rel}")
    message(STATUS "FAIL ${rel}: frozen copy missing")
    set(_failed TRUE)
    continue()
  endif()
  file(SHA256 "${FROZEN_DIR}/${rel}" _h)
  set(_want "${SA_HASH_${id}}")
  set(_from_manifest "(manifest absent)")
  if(NOT _manifest STREQUAL "")
    string(JSON _from_manifest GET "${_manifest}" "src/app/${leaf}")
    if(NOT _from_manifest STREQUAL _want)
      message(STATUS "FAIL ${leaf}: recorded entry hash ${_want} differs from manifest ${_from_manifest}")
      set(_failed TRUE)
    endif()
  endif()
  if(_h STREQUAL _want)
    message(STATUS "ok   frozen ${leaf} sha256 ${_h} == entry manifest ${_from_manifest}")
  else()
    message(STATUS "FAIL frozen ${leaf} sha256 ${_h} != entry ${_want}")
    set(_failed TRUE)
  endif()
endforeach()

if(_failed)
  message(FATAL_ERROR "scene-admission-001: frozen sources do NOT match the supervisor entry manifest")
endif()
message(STATUS "RESULT: frozen sources match the supervisor entry manifest")
