# Check that every scancode listed on the shortcuts page is handled in level play.
file(READ "${SOURCE_DIR}/src/app/SoundMenu.cpp" sound_menu)
string(REGEX MATCH "kShortcuts\\[\\]\\{[^;]+;" shortcut_table "${sound_menu}")
string(REGEX MATCHALL "SDL_SCANCODE_[A-Z0-9_]+" documented "${shortcut_table}")
list(REMOVE_DUPLICATES documented)

file(READ "${SOURCE_DIR}/src/app/main.cpp" level_loop)
# The outer keydown branch in routeEvent is for gameplay. The nested branch above it is for the menu.
string(FIND "${level_loop}" "\n      } else if (event.type == SDL_KEYDOWN && !event.key.repeat) {" start)
if(start LESS 0)
  message(FATAL_ERROR "Could not locate the level key handler.")
endif()
string(SUBSTRING "${level_loop}" ${start} -1 keydown_tail)
string(FIND "${keydown_tail}" "\n      recordCommands();" length)
if(length LESS 0)
  message(FATAL_ERROR "Could not locate the end of the level key handler.")
endif()
string(SUBSTRING "${keydown_tail}" 0 ${length} level_keydown)
string(REGEX REPLACE "//[^\n]*" "" level_keydown "${level_keydown}")
string(REGEX MATCHALL "SDL_SCANCODE_[A-Z0-9_]+" handled "${level_keydown}")
if(NOT documented OR NOT handled)
  message(FATAL_ERROR "Could not read keyboard shortcuts or the level key handler.")
endif()

set(stale ${documented})
list(REMOVE_ITEM stale ${handled})
if(stale)
  message(FATAL_ERROR "Keyboard Shortcuts lists keys unhandled in level play: ${stale}.")
endif()
list(LENGTH documented count)
message(STATUS "Level play handles all ${count} listed scancodes")
