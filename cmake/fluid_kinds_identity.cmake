# Verify the four frozen render files against the authentic task-entry manifest.
file(SHA256 "${TASK_DIR}/before-hashes.json" manifest_sha)
if(NOT manifest_sha STREQUAL "eac202e7e68477ceb4f9f3dd370e2c974a6e16603535200767fb6675a578ab85")
  message(FATAL_ERROR "fluid-kinds task-entry manifest changed")
endif()
file(READ "${TASK_DIR}/before-hashes.json" manifest)
foreach(path IN ITEMS src/app/BackdropScene.cpp src/app/BackdropScene.h src/app/TubeScene.cpp src/app/TubeScene.h)
  string(JSON expected GET "${manifest}" "${path}")
  file(SHA256 "${TASK_DIR}/frozen-render/${path}" measured)
  if(NOT measured STREQUAL expected)
    message(FATAL_ERROR "fluid-kinds frozen source changed: ${path}")
  endif()
endforeach()
