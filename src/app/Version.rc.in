#include <winver.h>

1 VERSIONINFO
FILEVERSION @file_version@
PRODUCTVERSION @file_version@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Lemmings Webolution"
      VALUE "FileVersion", "@WEBOLUTION_VERSION@"
      VALUE "OriginalFilename", "webolution.exe"
      VALUE "ProductName", "Lemmings Webolution"
      VALUE "ProductVersion", "@WEBOLUTION_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
