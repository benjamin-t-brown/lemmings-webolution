file(SHA256 "${TASK_DIR}/entry-manifest.json" manifest_hash)
if(NOT manifest_hash STREQUAL "9ce1f7d5ed6c123c5c769d5ef2ec39916505da7a6a2fe66f562e5c01e17429b4")
  message(FATAL_ERROR "lever-render task-entry manifest changed")
