# Check the displayed table against the production input handlers. SDL keycodes
# in the frontend and scancodes in the level loop use the same suffixes here.
file(READ "${SOURCE_DIR}/src/app/SoundMenu.cpp" sound_menu)
string(REGEX MATCH "kShortcuts\\[\\]\\[[0-9]+\\]\\{[^;]+;" shortcut_table "${sound_menu}")
string(REGEX MATCHALL "SDL_SCANCODE_[A-Z0-9_]+" documented "${shortcut_table}")
list(REMOVE_DUPLICATES documented)

file(GLOB_RECURSE input_sources "${SOURCE_DIR}/src/app/*.cpp" "${SOURCE_DIR}/src/app/*.h"
  "${SOURCE_DIR}/src/app/*.hpp" "${SOURCE_DIR}/src/shell/*.cpp" "${SOURCE_DIR}/src/shell/*.h")
set(handled)
foreach(source IN LISTS input_sources)
  file(READ "${source}" contents)
  if(source MATCHES "/SoundMenu\\.cpp$")
    string(REPLACE "${shortcut_table}" "" contents "${contents}")
  endif()
  string(REGEX REPLACE "//[^\n]*" "" contents "${contents}")
  string(REGEX MATCHALL "SDL_(SCANCODE_[A-Z0-9_]+)|SDLK_[A-Za-z0-9_]+" keys "${contents}")
  foreach(key IN LISTS keys)
    string(TOUPPER "${key}" key)
    string(REGEX REPLACE "^SDLK_" "SDL_SCANCODE_" key "${key}")
    list(APPEND handled "${key}")
  endforeach()
endforeach()
list(REMOVE_DUPLICATES handled)
if(NOT documented OR NOT handled)
  message(FATAL_ERROR "Could not read keyboard shortcuts or input handlers.")
endif()

set(missing ${handled})
list(REMOVE_ITEM missing ${documented})
set(stale ${documented})
list(REMOVE_ITEM stale ${handled})
if(missing OR stale)
  message(FATAL_ERROR "Keyboard Shortcuts table mismatch. Missing: ${missing}. Stale: ${stale}.")
endif()
list(LENGTH handled count)
message(STATUS "Keyboard Shortcuts covers ${count} scancodes")
