file(READ "${TASK_DIR}/before-sha256.json" manifest)
string(JSON count LENGTH "${manifest}")
math(EXPR last "${count}-1")
foreach(i RANGE 0 ${last})
  string(JSON name MEMBER "${manifest}" ${i})
  string(JSON expected GET "${manifest}" "${name}")
  file(SHA256 "${TASK_DIR}/before-source/${name}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Gravity task-entry source changed: ${name}")
  endif()
endforeach()
